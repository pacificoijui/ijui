// Regras do Firestore do projeto "processos-ijui" (Agenda + Sistema Interno /
// pregoeiro). Cole isto em: Firebase Console → processos-ijui → Firestore
// Database → Regras → colar → Publicar.
//
// Ver CONTROLE-DE-ACESSO.md na raiz do repositório para o desenho completo:
// por que cada coleção está do jeito que está, e quais links continuam
// deliberadamente públicos (compartilhamento sem login).
//
// Este arquivo é a fonte da verdade do que as regras DEVERIAM ser — não é
// aplicado automaticamente (não há deploy por CI aqui, só o console mesmo).
// Se editar este arquivo, publique a mudança no console também.
//
// "impugnacoes", "ferias", "reequilibrios" e "reequilibrio_tramites"
// existiam nas regras antigas (abertas, se não fosse pra tirar não faria
// diferença) mas não são lidas nem escritas por nenhum código atual do
// site — busca no repositório inteiro não achou nenhuma referência. Ficam
// de fora de propósito: sem regra nenhuma, uma coleção fica fechada por
// padrão, que é o comportamento certo pra dado que ninguém mais acessa. Se
// algum dia alguma delas voltar a ser usada, é só adicionar aqui.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Funções auxiliares ──────────────────────────────────────────────
    function perfil() {
      return get(/databases/$(database)/documents/usuarios_v2/$(request.auth.uid)).data;
    }
    function autenticado() { return request.auth != null; }
    function aprovado()    { return autenticado() && perfil().status == 'aprovado'; }
    function admin()       { return autenticado() && perfil().isAdmin == true; }
    // Nível de acesso por painel: 'nenhum' | 'ver' | 'editar'. Contas
    // aprovadas antes deste modelo guardam "true"/"false" (o formato
    // antigo, só liberado/bloqueado) — nivel() trata os dois formatos
    // igual, sem precisar migrar nenhum documento: true equivale a
    // 'editar', false/ausente equivale a 'nenhum'.
    //
    // O .get('acessos', {}).get(painel, 'nenhum') é de propósito: ler um
    // campo que não existe derruba a avaliação inteira da regra. Com o
    // valor padrão, um documento de conta sem "acessos" (ou sem aquele
    // painel) simplesmente não tem acesso, em vez de virar erro.
    function bruto(painel) { return perfil().get('acessos', {}).get(painel, 'nenhum'); }
    function nivel(painel) {
      return bruto(painel) == true ? 'editar'
           : (bruto(painel) == 'ver' || bruto(painel) == 'editar') ? bruto(painel)
           : 'nenhum';
    }
    // Admin sempre edita tudo — é o próprio propósito do cargo.
    function temAcesso(painel)  { return aprovado() && (admin() || nivel(painel) != 'nenhum'); }
    function podeEditar(painel) { return aprovado() && (admin() || nivel(painel) == 'editar'); }
    function agenda()    { return temAcesso('agenda'); }
    function pregoeiro() { return temAcesso('pregoeiro'); }
    function contratos() { return temAcesso('contratos'); }
    function algum()     { return agenda() || pregoeiro(); }
    // O calendário (feriados do município, aniversários dos servidores e a
    // observação do dia) é o mesmo para a Agenda de Licitações e para a
    // Agenda de Contratos, lido das mesmas coleções. Quem só tem o painel
    // Contratos precisa LER essas três — sem isso o calendário abriria sem
    // feriado nenhum. Escrever continua sendo só de quem cuida da Agenda:
    // cadastro em dois lugares vira dois cadastros.
    function algumCalendario() { return algum() || contratos(); }
    // As mesmas, mas exigindo nível 'editar' — usadas em toda regra de
    // escrita, pra quem está em "somente visualização" nunca conseguir
    // gravar nada, nem contornando a trava do lado do cliente.
    function agendaEdit()    { return podeEditar('agenda'); }
    function pregoeiroEdit() { return podeEditar('pregoeiro'); }
    function contratosEdit() { return podeEditar('contratos'); }
    function algumEdit()     { return agendaEdit() || pregoeiroEdit(); }

    // ── Contas e permissões ──────────────────────────────────────────────
    // Documento por pessoa, ID = uid do Firebase Auth. Cada um só cria o
    // PRÓPRIO documento, e só de duas formas: o e-mail de resgate nasce
    // administrador com tudo liberado (garante que nunca falte alguém
    // capaz de aprovar os demais); qualquer outro e-mail só nasce
    // "pendente" e sem nenhum acesso. Liberar de verdade é sempre um
    // update feito por quem já é admin — nunca o próprio auto-cadastro.
    //
    // Se trocar o e-mail de resgate aqui, troque também a constante
    // AUTH_BOOTSTRAP_ADMIN_EMAIL em index.html e pregoeiro/index.html.
    match /usuarios_v2/{uid} {
      allow get: if autenticado() && (request.auth.uid == uid || admin());
      allow list: if admin();
      // O auto-cadastro só pode nascer de duas formas: o e-mail de resgate
      // já administrador, ou qualquer outro "pendente" e sem acesso nenhum.
      //
      // Os dois formatos de "sem acesso" são aceitos ('nenhum' e o antigo
      // false) porque uma aba aberta há dias, ou uma página em cache, ainda
      // manda o formato antigo — e negar aí só produziria um "Missing or
      // insufficient permissions" na cara de quem está se cadastrando. Nos
      // dois casos o resultado é o mesmo: nasce sem poder nenhum.
      function nascePendente(d) {
        return d.status == 'pendente' && d.isAdmin == false &&
          (d.get('acessos', {}).get('agenda', 'nenhum')    in ['nenhum', false]) &&
          (d.get('acessos', {}).get('pregoeiro', 'nenhum') in ['nenhum', false]) &&
          (d.get('acessos', {}).get('contratos', 'nenhum') in ['nenhum', false]);
      }
      function nasceResgate(d) {
        return request.auth.token.email.lower() == 'pedrohhpacifico@gmail.com' &&
          d.status == 'aprovado' && d.isAdmin == true;
      }
      allow create: if autenticado() && request.auth.uid == uid &&
        request.resource.data.email == request.auth.token.email.lower() &&
        (nasceResgate(request.resource.data) || nascePendente(request.resource.data));
      allow update: if admin();
      allow delete: if admin();
    }

    // Pré-cadastro por e-mail: um lembrete pro admin, nada mais. Não dá
    // acesso sozinho a ninguém — quem aplica é sempre o admin, com a
    // permissão que ele já tem sobre usuarios_v2 acima.
    match /usuarios_v2_convites/{id} {
      allow read, write: if admin();
    }

    // Cadastro antigo (usuário/senha). Não autentica mais ninguém — fica
    // só de leitura pro admin acompanhar quem falta migrar.
    match /usuarios/{id} {
      allow read: if admin();
      allow write: if false;
    }

    // ── Licitações ───────────────────────────────────────────────────────
    // "get" público em processos/rankings/habilitacoes preserva os links de
    // compartilhamento existentes (?venc=, ?ranking=, ?hab=) — cada um abre
    // UM documento específico, cujo id é essencialmente um segredo longo;
    // "list" (percorrer a coleção inteira) continua fechado, então não dá
    // pra descobrir nenhum desses ids sem já ter recebido o link.
    match /processos/{id} {
      allow get: if true;
      allow list: if algum();
      allow create, update: if algumEdit();
      allow delete: if pregoeiroEdit();
    }

    // "get" público preserva o link "?assinatura=ID" (o pregoeiro assina uma
    // vez pelo celular, sem conta, e a assinatura passa a valer nas
    // decisões futuras). O "update" público fica restrito aos 3 campos que
    // esse link realmente grava — o resto do cadastro do agente não muda
    // por ali.
    match /agentes/{id} {
      allow get: if true;
      allow list: if algum();
      allow create: if algumEdit();
      allow update: if algumEdit() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assinaturaImg','assinaturaEm','updatedAt']);
      allow delete: if pregoeiroEdit();
    }

    match /status/{id}               { allow read: if algum(); allow write: if pregoeiroEdit(); }
    match /pontos_facultativos/{id}  { allow read: if algumCalendario(); allow write: if algumEdit(); }
    match /aniversarios/{id}         { allow read: if algumCalendario(); allow write: if algumEdit(); }
    match /observacoes/{id}          { allow read: if algumCalendario(); allow write: if algumEdit(); }
    match /email_config/{id}         { allow read: if algum(); allow write: if pregoeiroEdit(); }

    // Rankings e Habilitações têm um link de colaboração sem login (o
    // pregoeiro manda "?ranking=ID" ou "?hab=ID" para quem está no comitê
    // — ver "Modo Compartilhado" no HTML). Por isso ficam deliberadamente
    // abertos, exatamente como hoje: quem tem o link vê e edita AQUELE
    // documento específico. "list" continua fechado.
    match /rankings/{id} {
      allow get, create, update: if true;
      allow list: if pregoeiro();
      allow delete: if pregoeiroEdit();
    }
    match /habilitacoes/{id} {
      allow get, create, update: if true;
      allow list: if pregoeiro();
      allow delete: if pregoeiroEdit();
    }

    // Decisões e diligências têm o mesmo tipo de link ("?assinar=ID") para
    // quem PRECISA ASSINAR um documento sem ter conta no sistema. Ali a
    // pessoa só deveria mudar a lista de assinaturas — nunca o texto da
    // decisão. affectedKeys() trava isso: o link de assinatura só consegue
    // alterar os campos "assinantes" e "updatedAt", nunca o resto do
    // documento.
    match /decisoes/{id} {
      allow get: if true;
      allow list: if pregoeiro();
      allow create, delete: if pregoeiroEdit();
      allow update: if pregoeiroEdit() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assinantes','updatedAt']);
    }
    match /diligencias/{id} {
      allow get: if true;
      allow list: if pregoeiro();
      allow create, delete: if pregoeiroEdit();
      allow update: if pregoeiroEdit() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assinantes','updatedAt']);
    }

    // ── Contratos ────────────────────────────────────────────────────────
    // Painel próprio ("contratos") dentro do MESMO cadastro de contas: quem
    // só cuida de contrato ganha nível em Contratos e "Sem acesso" nos
    // outros dois, e continua sendo uma conta só, aprovada num lugar só.
    //
    // Aqui não existe link público nenhum — nem "get" aberto —, então tudo
    // exige conta aprovada com o painel liberado: ver exige o painel,
    // gravar exige nível "editar". Sem exclusão pela tela: contrato saindo
    // do ar é "situação: INATIVO", não documento apagado.
    match /contratos/{id} {
      allow get, list: if contratos();
      allow create, update: if contratosEdit();
      allow delete: if false;
    }

    // Histórico de edições dos contratos: um registro por gravação, com o
    // contrato inteiro antes e depois. Quem vê contrato vê o histórico —
    // saber quem mexeu no quê é parte de acompanhar o cadastro.
    //
    // Três travas que fazem o histórico valer alguma coisa:
    //  · o "uid" gravado tem de ser o de quem está gravando, senão daria
    //    para registrar uma edição em nome de outra pessoa;
    //  · nenhum update: registro de histórico não se reescreve. Corrigir o
    //    contrato gera um registro NOVO (é o que o "desfazer" da tela faz);
    //  · apagar, só o que já passou da validade. Assim a limpeza dos 365
    //    dias funciona e, ao mesmo tempo, ninguém consegue sumir com o
    //    rastro do que fez ontem — nem um admin, nem quem fez a edição.
    //
    // A limpeza roda na própria tela, quando alguém abre o painel. Para o
    // Firestore fazer isso sozinho, crie uma política de TTL no console
    // apontando para o campo "expiraEm" desta coleção.
    match /contratos_historico/{id} {
      allow get, list: if contratos();
      allow create: if contratosEdit() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.expiraEm is timestamp;
      allow update: if false;
      allow delete: if contratosEdit() && resource.data.expiraEm < request.time;
    }
  }
}
